ALLOW_INSECURE_DEV_TOKENS=true
AI_PROVIDER_MODE=mock
AI_GENERATION_DELAY_SECONDS=3
DEFAULT_TRACK_DURATION_SECONDS=30
LOCAL_STORAGE_DIR=local_storage
